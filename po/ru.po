#: terminal/terminal-preferences-dialog.c:278
#: terminal/terminal-search-dialog.c:115
msgid "_Close"
msgstr "_Закрыть"

#. add the "Help" button
#: terminal/terminal-preferences-dialog.c:286 terminal/terminal-window.c:1378
msgid "_Help"
msgstr "_Справка"

#.
#. * General
#.
#. section: General
#: terminal/terminal-preferences-dialog.c:308
#: terminal/terminal-preferences-dialog.c:1550
msgid "General"
msgstr "Общие"

#. section: Title
#: terminal/terminal-preferences-dialog.c:322
msgid "Title"
msgstr "Заголовок"

#: terminal/terminal-preferences-dialog.c:324
msgid "_Initial title:"
msgstr "_Начальный заголовок:"

#: terminal/terminal-preferences-dialog.c:340
msgid "Dynamically-set title:"
msgstr "Динамически устанавливаемый заголовок:"

#: terminal/terminal-preferences-dialog.c:346
msgid "Replaces initial title"
msgstr "Заменяет начальный заголовок"

#: terminal/terminal-preferences-dialog.c:347
msgid "Goes before initial title"
msgstr "Вставляется перед начальным заголовком"

#: terminal/terminal-preferences-dialog.c:348
msgid "Goes after initial title"
msgstr "Вставляется после начального заголовка"

#: terminal/terminal-preferences-dialog.c:349
msgid "Isn't displayed"
msgstr "Не отображается"

#. section: Command
#: terminal/terminal-preferences-dialog.c:361
msgid "Command"
msgstr "Команда"

#: terminal/terminal-preferences-dialog.c:363
msgid "_Run command as login shell"
msgstr "Запускать ко_манду в login shell"

#: terminal/terminal-preferences-dialog.c:367
msgid ""
"Select this option to force Terminal to run your shell as a login shell when "
"you open new terminals. See the documentation of your shell for details "
"about differences between running it as interactive shell and running it as "
"login shell."
msgstr ""
"Включите эту опцию, чтобы терминал запускался в режиме начального командного "
"интерпретатора (login shell). Обратитесь к документации по используемому "
"вами командному интерпретатору, чтобы узнать, в чём отличия между запуском в "
"интерактивном режиме и режиме начального командного интерпретатора."

#: terminal/terminal-preferences-dialog.c:378
msgid "_Run a custom command instead of my shell"
msgstr "_Запустить пользовательскую команду вместо моей оболочки"

#: terminal/terminal-preferences-dialog.c:382
msgid ""
"Select this option to force Terminal to run a custom command instead of your "
"shell when you open new terminals"
msgstr ""
"Выберите этот параметр, чтобы заставить Терминал запускать пользовательскую "
"команду вместо вашей оболочки при открытии новых терминалов"

#: terminal/terminal-preferences-dialog.c:390
msgid "Custom command:"
msgstr "Пользовательская команда:"

#: terminal/terminal-preferences-dialog.c:415
msgid "_Working directory:"
msgstr "Рабо_чий каталог:"

#: terminal/terminal-preferences-dialog.c:419
msgid ""
"Select this option to make new terminals (tabs or windows) use custom "
"working directory. Otherwise, current working directory will be used."
msgstr ""
"Включите эту опцию, чтобы новые терминалы (вкладки или окна) использовали "
"указанный рабочий каталог. В противном случае, будет использован текущий "
"рабочий каталог."

#. section: Scrolling
#: terminal/terminal-preferences-dialog.c:440
msgid "Scrolling"
msgstr "Прокрутка"

#: terminal/terminal-preferences-dialog.c:442
msgid "_Scroll on output"
msgstr "_Прокручивать вывод"

#: terminal/terminal-preferences-dialog.c:446
msgid ""
"This option controls whether the terminal will scroll down automatically "
"whenever new output is generated by the commands running inside the terminal."
msgstr ""
"Этот параметр определяет, будет ли окно терминала прокручиваться "
"автоматически по мере вывода информации запущенными программами."

#: terminal/terminal-preferences-dialog.c:452
msgid "_Scroll on keystroke"
msgstr "_Прокручивать по нажатию клавиши"

#: terminal/terminal-preferences-dialog.c:456
msgid ""
"Enables you to press any key on the keyboard to scroll down the terminal to "
"the command prompt."
msgstr ""
"Позволяет нажать любую клавишу на клавиатуре, чтобы прокрутить терминал вниз "
"до командной строки."

#: terminal/terminal-preferences-dialog.c:466
msgid "_Enable kinetic scrolling"
msgstr "Включить кинетическ_ую прокрутку"

#: terminal/terminal-preferences-dialog.c:470
msgid ""
"This controls whether scrolling \"coasts\" to a stop when releasing a "
"touchpad or touchscreen."
msgstr ""
"Этот параметр определяет, будет ли прокрутка останавливаться при отпускании "
"сенсорной панели или сенсорного экрана."

#: terminal/terminal-preferences-dialog.c:479
msgid "Scrollbar is:"
msgstr "Полоса прокрутки:"

#: terminal/terminal-preferences-dialog.c:485
msgid "Disabled"
msgstr "Отключена"

#: terminal/terminal-preferences-dialog.c:486
msgid "On the left side"
msgstr "Слева"

#: terminal/terminal-preferences-dialog.c:487
msgid "On the right side"
msgstr "Справа"

#: terminal/terminal-preferences-dialog.c:500
msgid "Scrollback:"
msgstr "Прокрутка назад:"

#: terminal/terminal-preferences-dialog.c:516
msgid "_Unlimited Scrollback"
msgstr "_Неограниченная прокрутка назад"

#: terminal/terminal-preferences-dialog.c:520
msgid "This controls whether the terminal will have no limits on scrollback."
msgstr ""
"Это определяет, не будет ли у терминала ограничений на прокрутку назад."

#: terminal/terminal-preferences-dialog.c:527
msgid "_Enable overlay scrolling (Requires restart)"
msgstr "_Включить прокрутку оверлея (требуется перезапуск)"

#: terminal/terminal-preferences-dialog.c:531
msgid ""
"This controls whether scrollbar is drawn as an overlay (auto-hide) or not."
msgstr ""
"Это определяет, будет ли полоса прокрутки отображаться как оверлей "
"(автоскрытие) или нет."

#. section: Cursor
#: terminal/terminal-preferences-dialog.c:538
msgid "Cursor"
msgstr "Курсор"

#: terminal/terminal-preferences-dialog.c:540
msgid "Cursor shape:"
msgstr "Форма курсора:"

#: terminal/terminal-preferences-dialog.c:546
msgid "Block"
msgstr "Блок"

#: terminal/terminal-preferences-dialog.c:547
msgid "I-Beam"
msgstr "I-образный"

#: terminal/terminal-preferences-dialog.c:548
msgid "Underline"
msgstr "Подчёркивание"

#: terminal/terminal-preferences-dialog.c:558
msgid "Cursor blinks"
msgstr "Мигающий курсор"

#: terminal/terminal-preferences-dialog.c:562
msgid "This option controls whether the cursor will be blinking or not."
msgstr "Этот параметр управляет миганием курсора."

#. The latch itself lives in the pane and is switched from the menu, while
#. * the program is a thing of the terminal: one for every pane.
#: terminal/terminal-preferences-dialog.c:570
msgid "Program of the _locked pane:"
msgstr "Программа _закреплённой панели:"

#: terminal/terminal-preferences-dialog.c:578
msgid "nothing: the pane simply stays"
msgstr "ничего: панель просто остаётся"

#: terminal/terminal-preferences-dialog.c:579
msgid ""
"Lock a pane with \"Lock this pane\" in the Terminal menu (Ctrl+Shift+L): "
"after its program ends the pane starts this one again, and a pane restored "
"in the next session comes back with it."
msgstr ""
"Закрепить панель можно пунктом «Закрепить панель» в меню «Терминал» "
"(Ctrl+Shift+L): когда её программа закончится, панель запустит эту программу "
"снова, а восстановленная в следующем запуске панель придёт с ней."

#.
#. * Session and Memory
#.
#. section: Session
#: terminal/terminal-preferences-dialog.c:593
#: terminal/terminal-preferences-dialog.c:606
msgid "Session"
msgstr "Сессия"

#: terminal/terminal-preferences-dialog.c:608
msgid "Save the session with the _split layout"
msgstr "Сохранять сессию с расположением _сплитов"

#: terminal/terminal-preferences-dialog.c:612
msgid ""
"Keeps between runs: split layout of every tab, working directory of every "
"pane. Programs that are running keep living when a tmux session is started "
"from the Terminal menu."
msgstr ""
"Сохраняет между запусками: расположение сплитов в каждой вкладке, рабочий "
"каталог каждой панели. Запущенные программы продолжают работать, если сессию "
"tmux запустить из меню «Терминал»."

#. the two that belong together stand next to each other: a tab is made of a
#. * split, so which tab and which pane are in front is one question
#: terminal/terminal-preferences-dialog.c:624
msgid "Bring back the _active tab"
msgstr "Возвращать на место _активную вкладку"

#: terminal/terminal-preferences-dialog.c:628
msgid "Puts the tab that was in front back in front when the terminal starts."
msgstr ""
"Возвращает на место вкладку, которая была впереди, при запуске терминала."

#: terminal/terminal-preferences-dialog.c:633
msgid "Bring back the _active pane"
msgstr "Возвращать на место _активную панель"

#: terminal/terminal-preferences-dialog.c:637
msgid ""
"Puts the pane that was in use inside the split tab back in use when the "
"terminal starts."
msgstr ""
"Возвращает в работу ту панель сплита, которая была активна, при запуске "
"терминала."

#. section: tmux
#: terminal/terminal-preferences-dialog.c:646
msgid "tmux"
msgstr "tmux"

#: terminal/terminal-preferences-dialog.c:647
msgid "Command to _start tmux:"
msgstr "Команда _запуска tmux:"

#: terminal/terminal-preferences-dialog.c:655
msgid "the default line below"
msgstr "строка по умолчанию ниже"

#: terminal/terminal-preferences-dialog.c:656
msgid ""
"Command run in the pane by \"Start tmux Session\" in the context menu "
"(Ctrl+Shift+M).\n"
"Left empty it runs the default line, which attaches to the session \"main\" "
"and lets programs pass 24-bit colour through."
msgstr ""
"Команда, выполняемая в панели пунктом «Запустить сеанс tmux» контекстного "
"меню (Ctrl+Shift+M).\n"
"Пустое поле — строка по умолчанию: подключается к сеансу «main» и разрешает "
"программам передавать 24-битный цвет."

#. section: Clipboard
#: terminal/terminal-preferences-dialog.c:671
msgid "Clipboard"
msgstr "Буфер обмена"

#: terminal/terminal-preferences-dialog.c:673
msgid "Automatically copy selection to clipboard"
msgstr "Автоматически копировать выделение в буфер обмена"

#: terminal/terminal-preferences-dialog.c:680
msgid "Show unsafe paste dialog"
msgstr "Показывать диалоговое окно небезопасной вставки"

#: terminal/terminal-preferences-dialog.c:684
msgid ""
"Show a dialog that allows one to edit text that is considered unsafe for "
"pasting"
msgstr ""
"Показывать диалог, который позволяет редактировать текст, который считается "
"небезопасным для вставки"

#: terminal/terminal-preferences-dialog.c:692
msgid "_Use clipboard slots"
msgstr "Ячейки _обмена"

#: terminal/terminal-preferences-dialog.c:696
msgid ""
"Keep a few slots of their own next to the system clipboard, so that more "
"than one string can be held at a time.\n"
"The slots live in memory: they are gone when the last window is closed, "
"unless they are kept in a file below."
msgstr ""
"Держать рядом с системным буфером обмена несколько ячеек своего обмена, "
"чтобы под рукой была не одна строка, а несколько.\n"
"Ячейки живут в памяти: они пропадают, когда закрывается последнее окно, если "
"не хранить их в файле ниже."

#: terminal/terminal-preferences-dialog.c:704
msgid ""
"How many slots of their own the terminal keeps next to the system clipboard"
msgstr ""
"Сколько ячеек своего обмена терминал держит рядом с системным буфером обмена"

#: terminal/terminal-preferences-dialog.c:719
msgid "Put into a slot when _copying:"
msgstr "Класть в ячейку при _копировании:"

#: terminal/terminal-preferences-dialog.c:727
msgid "Plain _text"
msgstr "Обычный _текст"

#: terminal/terminal-preferences-dialog.c:729
msgid "_Links only"
msgstr "Только _ссылки"

#: terminal/terminal-preferences-dialog.c:731
msgid "_HTML"
msgstr "_HTML"

#: terminal/terminal-preferences-dialog.c:736
msgid "_Nested submenu"
msgstr "Вложенное _подменю"

#: terminal/terminal-preferences-dialog.c:743
msgid ""
"Put the slots of each direction under a submenu of their own instead of an "
"entry per slot."
msgstr ""
"Собрать ячейки каждого направления в отдельное подменю вместо пункта на "
"каждую ячейку."

#: terminal/terminal-preferences-dialog.c:750
msgid "Keep _slots in a file"
msgstr "Хранить ячейки в _файле"

#: terminal/terminal-preferences-dialog.c:757
msgid ""
"Write the contents of the slots to the file on the right when the last "
"window is closed and read them back at the next start.\n"
"Without this the slots live only as long as the session."
msgstr ""
"Записывать содержимое ячеек в файл справа при закрытии последнего окна и "
"читать его обратно при следующем запуске.\n"
"Без этого ячейки живут только до конца сеанса."

#: terminal/terminal-preferences-dialog.c:776
msgid ""
"An empty field means the default path shown here. The file is written once "
"the last window is closed."
msgstr ""
"Пустое поле означает путь по умолчанию, показанный здесь. Файл записывается, "
"когда закрывается последнее окно."

#.
#. * Drop-down
#.
#: terminal/terminal-preferences-dialog.c:792
msgid "Drop-down"
msgstr "Выпадающий"

#. section: Behavior
#: terminal/terminal-preferences-dialog.c:807
msgid "Behavior"
msgstr "Поведение"

#. How the drop-down window is to be reached is worth one plain line here,
#. * and it stays a plain line: a plain label that is not a dismissible info
#. * bar, small so that it takes as little room as possible.
#: terminal/terminal-preferences-dialog.c:812
msgid ""
"Regardless of the settings below, you get the drop-down terminal window if "
"you add a hotkey for \"xfce4-terminal-next --drop-down\"."
msgstr ""
"Вне зависимости от настроек ниже вы получаете выпадающее окно терминала, "
"если добавите хоткей для команды \"xfce4-terminal-next --drop-down\"."

#: terminal/terminal-preferences-dialog.c:824
msgid "_Keep window open when it loses focus"
msgstr "_Не закрывать окно, если оно теряет фокус"

#: terminal/terminal-preferences-dialog.c:834
msgid "_Use app shortcut to focus the window"
msgstr "Использо_вать ярлык приложения, чтобы сфокусировать окно"

#: terminal/terminal-preferences-dialog.c:838
msgid ""
"If enabled, the app shortcut for 'xfce4-terminal --drop-down', which "
"normally opens and closes the window, will give it focus if the option to "
"keep the window open is checked."
msgstr ""
"Если включено, то ярлык приложения для «xfce4-terminal --drop-down», который "
"обычно открывает и закрывает окно, будет передавать ему фокус, если отмечен "
"параметр «держать окно открытым»."

#: terminal/terminal-preferences-dialog.c:849
msgid "_Always keep window above"
msgstr "Все_гда поверх всех окон"

#: terminal/terminal-preferences-dialog.c:862
msgid "_Always show the status icon (do not quit the process)"
msgstr "Все_гда показывать значок в трее (не завершать процесс)"

#: terminal/terminal-preferences-dialog.c:866
msgid ""
"Keep the drop-down window and its status icon alive: when the shell of the "
"last tab ends, a fresh tab is opened and the window is hidden instead of "
"being closed. Closing the window explicitly still quits the application."
msgstr ""
"Не закрывать выпадающее окно и не убирать его значок: когда оболочка "
"последней вкладки завершается, вместо закрытия окна открывается новая "
"вкладка, а само окно скрывается. Явное закрытие окна по-прежнему завершает "
"приложение."

#: terminal/terminal-preferences-dialog.c:878
msgid "Toggle the window when _started again"
msgstr "_Переключать окно при повторном запуске"

#: terminal/terminal-preferences-dialog.c:882
msgid ""
"Show or hide the drop-down window when the application is started again, "
"instead of opening a new tab in it."
msgstr ""
"Показывать или скрывать выпадающее окно при повторном запуске приложения "
"вместо открытия в нём новой вкладки."

#: terminal/terminal-preferences-dialog.c:897
msgid "Use a _system shortcut to hide and show the terminal"
msgstr ""
"Использовать _системную горячую клавишу для скрытия и появления терминала"

#: terminal/terminal-preferences-dialog.c:905
#, c-format
msgid ""
"Show or hide the drop-down terminal window with a shortcut of the desktop.\n"
"\n"
"What it does:\n"
"• binds the key you press to \"%s\";\n"
"• the desktop handles the key, so it works on X11 and Wayland alike;\n"
"• toggles the window: hidden becomes shown, shown becomes hidden.\n"
"\n"
"What it does not do:\n"
"• does not grab the key itself; the terminal keeps no shortcut of its own;\n"
"• without a shortcut the window is opened by the command alone."
msgstr ""
"Показывать или скрывать выпадающее окно терминала горячей клавишей рабочего "
"стола.\n"
"\n"
"Что делает:\n"
"• назначает нажатое сочетание на команду «%s»;\n"
"• клавишу обрабатывает рабочий стол, поэтому работает и в X11, и в Wayland;\n"
"• переключает окно: скрытое показывает, показанное скрывает.\n"
"\n"
"Что не делает:\n"
"• не перехватывает клавишу сам — своих горячих клавиш терминал не держит;\n"
"• без горячей клавиши окно открывается только командой."

#. the key in use and the button that changes it share the row of the
#. * check box: the check box used to span three columns and covered them
#: terminal/terminal-preferences-dialog.c:926
msgid "Change _shortcut..."
msgstr "Сменить _горячую клавишу..."

#: terminal/terminal-preferences-dialog.c:928
msgid "Press the new key combination and confirm it."
msgstr "Нажмите новую комбинацию клавиш и подтвердите выбор."

#. The shortcut settings of this desktop are not the Xfce ones, so the
#. * check box would look as if it worked and quietly do nothing: give the
#. * command to assign by hand instead.
#: terminal/terminal-preferences-dialog.c:950
msgid ""
"This desktop does not use the Xfce shortcut settings, so the terminal "
"shortcut has to be assigned by hand. Bind this command in the keyboard "
"shortcuts of your desktop:"
msgstr ""
"Этот рабочий стол не использует настройки горячих клавиш Xfce, поэтому "
"клавишу панели нужно назначить вручную. Свяжите эту команду в горячих "
"клавишах вашего рабочего стола:"

